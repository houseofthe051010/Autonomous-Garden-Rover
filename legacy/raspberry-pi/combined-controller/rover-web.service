[Unit]
Description=Garden Rover UART web controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aditya
Group=aditya
SupplementaryGroups=dialout
WorkingDirectory=/home/aditya/rover-controller
Environment=PYTHONUNBUFFERED=1
Environment=ROVER_WEB_AUTH=0
ExecStart=/usr/bin/python3 /home/aditya/rover-controller/rover_web.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
UMask=0077
# The service has narrowly scoped NOPASSWD access only to rover-wifi-mode's
# three fixed subcommands. sudo cannot use that rule with NoNewPrivileges=true.
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
