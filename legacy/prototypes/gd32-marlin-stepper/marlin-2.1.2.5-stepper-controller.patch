diff --git a/Marlin/src/MarlinCore.cpp b/Marlin/src/MarlinCore.cpp
index 8fddd12..a36ae61 100644
--- a/Marlin/src/MarlinCore.cpp
+++ b/Marlin/src/MarlinCore.cpp
@@ -844,6 +844,59 @@ void idle(const bool no_stepper_sleep/*=false*/) {
   // Handle UI input / draw events
   TERN(DWIN_CREALITY_LCD, DWIN_Update(), ui.update());
 
+  #if ENABLED(STEPPER_LINK_HEARTBEAT)
+    {
+      static millis_t next_heartbeat_ms;
+      static uint16_t heartbeat_sequence;
+      const millis_t heartbeat_ms = millis();
+      if (ELAPSED(heartbeat_ms, next_heartbeat_ms)) {
+        next_heartbeat_ms = heartbeat_ms + STEPPER_LINK_HEARTBEAT_INTERVAL;
+        MYSERIAL1.print("HB ");
+        MYSERIAL1.println(++heartbeat_sequence);
+        #if HAS_STATUS_MESSAGE
+          ui.set_status("Heartbeat out", true);
+        #endif
+      }
+    }
+  #endif
+
+  #if ENABLED(STEPPER_LINK_SWITCH_REPORT)
+    {
+      static millis_t next_switch_sample_ms, next_switch_report_ms;
+      static uint8_t candidate_switches = 0xFF, stable_switches = 0xFF, stable_samples;
+      const millis_t switch_ms = millis();
+      if (ELAPSED(switch_ms, next_switch_sample_ms)) {
+        next_switch_sample_ms = switch_ms + STEPPER_LINK_SWITCH_SAMPLE_INTERVAL;
+        const uint8_t sampled_switches =
+            (READ(X_MIN_PIN) != X_MIN_ENDSTOP_INVERTING ? _BV(0) : 0)
+          | (READ(Y_MIN_PIN) != Y_MIN_ENDSTOP_INVERTING ? _BV(1) : 0)
+          | (READ(Z_MIN_PIN) != Z_MIN_ENDSTOP_INVERTING ? _BV(2) : 0);
+
+        if (sampled_switches == candidate_switches) {
+          if (stable_samples < STEPPER_LINK_SWITCH_DEBOUNCE_SAMPLES) ++stable_samples;
