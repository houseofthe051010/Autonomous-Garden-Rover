+    uint32_t status = 0;
+    if (odrv.config_.gpio_modes[external_gpio] !=
+        ODriveIntf::GPIO_MODE_ANALOG_IN || channel >= ADC_CHANNEL_COUNT) {
+        status |= status_gpio_mode;
+    }
+    if (!(vbus_voltage_external >= minimum_external_voltage)) {
+        status |= status_low;
+    }
+    if (!(vbus_voltage_external_adc < maximum_external_adc_voltage)) {
+        status |= status_high;
