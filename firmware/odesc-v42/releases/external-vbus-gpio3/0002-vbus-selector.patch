+        valid_samples = 0;
+        if (invalid_samples < invalid_samples_required) ++invalid_samples;
+        vbus_voltage_external_valid = false;
+        vbus_voltage_external_status = status;
+        if (invalid_samples >= invalid_samples_required) {
+            vbus_voltage_external_fault = true;
