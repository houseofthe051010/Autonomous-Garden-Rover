+    constexpr uint32_t valid_samples_required = 32;
+    constexpr uint32_t invalid_samples_required = 64;
+    constexpr uint32_t status_warmup = 1U << 0;
+    constexpr uint32_t status_gpio_mode = 1U << 1;
+    constexpr uint32_t status_low = 1U << 2;
+    constexpr uint32_t status_high = 1U << 3;
+    constexpr uint32_t status_mismatch = 1U << 4;
+    constexpr float internal_scale =
+        adc_ref_voltage * VBUS_S_DIVIDER_RATIO / adc_full_scale;
+
+    static uint32_t valid_samples = 0;
+    static uint32_t invalid_samples = 0;
+    static bool accepted_once = false;
+
+    vbus_voltage_internal_raw = adc_value;
+    vbus_voltage_internal_adc = adc_value * adc_ref_voltage / adc_full_scale;
+    vbus_voltage_internal = adc_value * internal_scale;
+
+    const uint16_t channel = channel_from_gpio(gpios[external_gpio]);
+    const uint16_t external_raw = channel < ADC_CHANNEL_COUNT ?
+        adc_measurements_[channel] : 0;
+    vbus_voltage_external_adc = external_raw * adc_ref_voltage / adc_full_scale;
+    vbus_voltage_external =
+        vbus_voltage_external_adc * vbus_voltage_external_scale;
