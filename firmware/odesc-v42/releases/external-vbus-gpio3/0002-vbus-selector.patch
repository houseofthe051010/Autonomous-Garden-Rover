+    const float internal_tolerance =
+        std::max(1.0f, 0.03f * vbus_voltage_internal);
+    const bool external_below_internal =
+        vbus_voltage_external + internal_tolerance < vbus_voltage_internal;
+    const bool external_above_comparable_internal =
+        vbus_voltage_internal < internal_compare_ceiling &&
+        vbus_voltage_external > vbus_voltage_internal + internal_tolerance;
+    if (external_below_internal || external_above_comparable_internal) {
+        status |= status_mismatch;
+    }
