+    if (sync_position) {
+      set_current_from_steppers_for_axis(ALL_AXES_ENUM);
+      sync_plan_position();
+    }
+  }
+
+  void Stepper::rover_motion_service() {
+    const RoverDirectMode mode = rover_direct_mode;
+    if (mode == ROVER_DIRECT_IDLE) return;
+
+    const uint32_t now = millis();
+    if (mode == ROVER_DIRECT_VELOCITY && ELAPSED(now, rover_last_command_ms + ROVER_DIRECT_WATCHDOG_MS)) {
+      rover_motion_stop();
+      MYSERIAL1.print("VEL_TIMEOUT I");
+      MYSERIAL1.println(rover_command_id);
+      return;
+    }
+
+    if (mode == ROVER_DIRECT_COUNTED_DONE) {
+      const uint32_t completed_id = rover_command_id;
+      int32_t completed_steps[4];
+      for (uint8_t a = 0; a < 4; ++a) completed_steps[a] = rover_requested_steps[a];
+      rover_motion_stop();
+      MYSERIAL1.print("COUNT_DONE I"); MYSERIAL1.print(completed_id);
+      MYSERIAL1.print(" X"); MYSERIAL1.print(completed_steps[X_AXIS]);
+      MYSERIAL1.print(" Y"); MYSERIAL1.print(completed_steps[Y_AXIS]);
+      MYSERIAL1.print(" Z"); MYSERIAL1.print(completed_steps[Z_AXIS]);
+      MYSERIAL1.print(" E"); MYSERIAL1.println(completed_steps[E_AXIS]);
+      return;
+    }
+
+    const uint32_t elapsed_ms = now - rover_last_ramp_ms;
+    if (!elapsed_ms) return;
+    rover_last_ramp_ms = now;
+    const int32_t ramp_amount = int32_t(ROVER_DIRECT_DEFAULT_RAMP_RPM_S) * int32_t(_MIN(elapsed_ms, 1000UL));
+
+    for (uint8_t a = 0; a < 4; ++a) {
+      const int32_t next = rover_ramp_toward(rover_actual_millirpm[a], rover_target_millirpm[a], ramp_amount);
+      rover_phase_increment[a] = 0;
+      rover_actual_millirpm[a] = next;
+      if (next < 0) SBI(rover_direction_bits, a); else CBI(rover_direction_bits, a);
+      rover_phase_increment[a] = rover_increment_from_millirpm(next);
+    }
+  }
+
+  bool Stepper::rover_motion_isr() {
+    const RoverDirectMode mode = rover_direct_mode;
+    if (mode == ROVER_DIRECT_IDLE) return false;
+
+    hal.isr_off();
+    HAL_timer_set_compare(MF_TIMER_STEP, hal_timer_t(HAL_TIMER_TYPE_MAX));
+
+    if (rover_direction_bits != last_direction_bits) {
+      const axis_bits_t changed = rover_direction_bits ^ last_direction_bits;
+      set_directions(rover_direction_bits);
+      for (uint8_t a = 0; a < 4; ++a)
+        if (TEST(changed, a)) rover_phase[a] = 0;
+    }
+
+    uint8_t step_bits = 0;
+    if (mode == ROVER_DIRECT_VELOCITY || mode == ROVER_DIRECT_COUNTED) {
+      for (uint8_t a = 0; a < 4; ++a) {
+        const uint32_t increment = rover_phase_increment[a];
+        if (!increment || (mode == ROVER_DIRECT_COUNTED && !rover_remaining_steps[a])) continue;
+        const uint32_t previous = rover_phase[a];
+        rover_phase[a] = previous + increment;
+        if (rover_phase[a] < previous) SBI(step_bits, a);
+      }
+    }
+
+    if (step_bits) {
+      if (TEST(step_bits, X_AXIS)) X_APPLY_STEP(!INVERT_X_STEP_PIN, 0);
+      if (TEST(step_bits, Y_AXIS)) Y_APPLY_STEP(!INVERT_Y_STEP_PIN, 0);
+      if (TEST(step_bits, Z_AXIS)) Z_APPLY_STEP(!INVERT_Z_STEP_PIN, 0);
+      if (TEST(step_bits, E_AXIS)) E_APPLY_STEP(!INVERT_E_STEP_PIN, 0);
+      DELAY_US(2);
+      if (TEST(step_bits, X_AXIS)) X_APPLY_STEP(INVERT_X_STEP_PIN, 0);
+      if (TEST(step_bits, Y_AXIS)) Y_APPLY_STEP(INVERT_Y_STEP_PIN, 0);
+      if (TEST(step_bits, Z_AXIS)) Z_APPLY_STEP(INVERT_Z_STEP_PIN, 0);
+      if (TEST(step_bits, E_AXIS)) E_APPLY_STEP(INVERT_E_STEP_PIN, 0);
+
+      for (uint8_t a = 0; a < 4; ++a) {
+        if (!TEST(step_bits, a)) continue;
+        count_position[a] += count_direction[a];
+        if (mode == ROVER_DIRECT_COUNTED && rover_remaining_steps[a]) {
+          if (!--rover_remaining_steps[a]) {
+            rover_target_millirpm[a] = rover_actual_millirpm[a] = 0;
+            rover_phase_increment[a] = 0;
+          }
+        }
+      }
+
+      if (mode == ROVER_DIRECT_COUNTED) {
+        bool any_remaining = false;
+        for (uint8_t a = 0; a < 4; ++a) any_remaining |= rover_remaining_steps[a] != 0;
+        if (!any_remaining) rover_direct_mode = ROVER_DIRECT_COUNTED_DONE;
+      }
+    }
+
+    HAL_timer_set_compare(MF_TIMER_STEP, hal_timer_t(STEPPER_TIMER_RATE / ROVER_DIRECT_ISR_HZ));
+    hal.isr_on();
+    return true;
+  }
+
+  void Stepper::rover_report_status() {
+    MYSERIAL1.print("DIRECT_STATUS M"); MYSERIAL1.print(uint8_t(rover_direct_mode));
+    MYSERIAL1.print(" I"); MYSERIAL1.print(rover_command_id);
+    MYSERIAL1.print(" X"); MYSERIAL1.print(float(rover_actual_millirpm[X_AXIS]) / 1000.0f, 3);
+    MYSERIAL1.print(" Y"); MYSERIAL1.print(float(rover_actual_millirpm[Y_AXIS]) / 1000.0f, 3);
+    MYSERIAL1.print(" Z"); MYSERIAL1.print(float(rover_actual_millirpm[Z_AXIS]) / 1000.0f, 3);
+    MYSERIAL1.print(" E"); MYSERIAL1.print(float(rover_actual_millirpm[E_AXIS]) / 1000.0f, 3);
+    MYSERIAL1.print(" A"); MYSERIAL1.println(rover_e_armed ? 1 : 0);
+  }
+
+#endif // ROVER_DIRECT_MOTION
+
 #if MINIMUM_STEPPER_PULSE || MAXIMUM_STEPPER_RATE
   #define ISR_PULSE_CONTROL 1
 #endif
