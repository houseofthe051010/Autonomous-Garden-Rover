+  static uint8_t parse_axis_steps(int32_t values[4]) {
+    uint8_t mask = 0;
+    LOOP_LOGICAL_AXES(a) {
+      if (a > E_AXIS) continue;
+      if (parser.seenval(AXIS_CHAR(a))) {
+        values[a] = parser.value_long();
+        if (!values[a]) return 0xFF;
+        SBI(mask, a);
+      }
+    }
+    return mask;
+  }
