+  bool Stepper::rover_set_velocity(const int32_t target_millirpm[4], const uint8_t update_mask, const uint32_t command_id) {
+    if (rover_direct_mode == ROVER_DIRECT_COUNTED || rover_direct_mode == ROVER_DIRECT_COUNTED_DONE)
+      return false;
+
+    for (uint8_t a = 0; a < 4; ++a) {
+      if (!TEST(update_mask, a)) continue;
+      if (ABS(target_millirpm[a]) > int32_t(ROVER_DIRECT_MAX_RPM) * 1000L) return false;
+      if (a == E_AXIS && target_millirpm[a] && !rover_e_armed) return false;
+    }
+
+    if (rover_direct_mode == ROVER_DIRECT_IDLE) {
+      planner.synchronize();
+      for (uint8_t a = 0; a < 4; ++a) {
+        rover_target_millirpm[a] = rover_actual_millirpm[a] = 0;
+        rover_phase[a] = rover_phase_increment[a] = rover_remaining_steps[a] = 0;
+      }
+      enable_axis(X_AXIS);
+      enable_axis(Y_AXIS);
+      enable_axis(Z_AXIS);
+      if (rover_e_armed) enable_extruder();
+      rover_last_ramp_ms = millis();
+      rover_direct_mode = ROVER_DIRECT_VELOCITY;
+      wake_up();
+    }
+
+    for (uint8_t a = 0; a < 4; ++a)
+      if (TEST(update_mask, a)) rover_target_millirpm[a] = target_millirpm[a];
