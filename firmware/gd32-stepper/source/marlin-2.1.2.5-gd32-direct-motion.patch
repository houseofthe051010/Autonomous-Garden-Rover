+  }
+
+  void Stepper::rover_motion_stop(const bool sync_position/*=true*/) {
+    if (rover_direct_mode == ROVER_DIRECT_IDLE) return;
+    const bool was_enabled = suspend();
+    for (uint8_t a = 0; a < 4; ++a) {
+      rover_target_millirpm[a] = rover_actual_millirpm[a] = 0;
+      rover_phase_increment[a] = rover_remaining_steps[a] = 0;
+    }
+    X_APPLY_STEP(INVERT_X_STEP_PIN, 0);
+    Y_APPLY_STEP(INVERT_Y_STEP_PIN, 0);
+    Z_APPLY_STEP(INVERT_Z_STEP_PIN, 0);
+    E_APPLY_STEP(INVERT_E_STEP_PIN, 0);
+    rover_direct_mode = ROVER_DIRECT_IDLE;
+    if (was_enabled) wake_up();
