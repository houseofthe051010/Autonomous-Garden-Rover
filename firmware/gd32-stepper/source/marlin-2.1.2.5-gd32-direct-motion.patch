+  static uint32_t rover_increment_from_millirpm(const int32_t millirpm) {
+    const uint32_t magnitude = ABS(millirpm);
+    return uint32_t(
+      (uint64_t(magnitude) * ROVER_DIRECT_MICROSTEPS_PER_REV * 0x100000000ULL)
