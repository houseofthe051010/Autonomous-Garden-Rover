+  bool Stepper::rover_start_counted(const int32_t steps[4], const uint8_t axis_mask, const uint32_t command_id) {
+    if (rover_direct_mode != ROVER_DIRECT_IDLE || !axis_mask) return false;
+
+    for (uint8_t a = 0; a < 4; ++a) {
+      if (!TEST(axis_mask, a)) continue;
+      if (!steps[a] || steps[a] == INT32_MIN) return false;
+      if (a == E_AXIS && !rover_e_armed) return false;
+    }
+
+    planner.synchronize();
+    axis_bits_t directions = 0;
+    for (uint8_t a = 0; a < 4; ++a) {
+      rover_phase[a] = rover_phase_increment[a] = 0;
+      rover_actual_millirpm[a] = 0;
+      rover_requested_steps[a] = TEST(axis_mask, a) ? steps[a] : 0;
+      rover_remaining_steps[a] = TEST(axis_mask, a) ? uint32_t(ABS(steps[a])) : 0;
+      rover_target_millirpm[a] = TEST(axis_mask, a)
+        ? (steps[a] < 0 ? -rover_counted_speed_millirpm[a] : rover_counted_speed_millirpm[a])
+        : 0;
+      if (rover_target_millirpm[a] < 0) SBI(directions, a);
+    }
+    rover_direction_bits = directions;
+    rover_command_id = command_id;
+    rover_last_ramp_ms = millis();
+    enable_axis(X_AXIS);
+    enable_axis(Y_AXIS);
+    enable_axis(Z_AXIS);
+    if (rover_e_armed) enable_extruder();
+    rover_direct_mode = ROVER_DIRECT_COUNTED;
+    wake_up();
+    return true;
+  }
