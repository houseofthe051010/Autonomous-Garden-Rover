+  static int32_t rover_ramp_toward(const int32_t actual, const int32_t target, const int32_t amount) {
+    if (actual > 0 && target < 0) return _MAX(0, actual - amount);
+    if (actual < 0 && target > 0) return _MIN(0, actual + amount);
+    if (actual < target) return _MIN(target, actual + amount);
+    if (actual > target) return _MAX(target, actual - amount);
+    return actual;
+  }
