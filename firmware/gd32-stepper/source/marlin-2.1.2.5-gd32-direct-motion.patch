+    for (uint8_t a = 0; a < 4; ++a) {
+      if (!TEST(update_mask, a)) continue;
+      if (speed_millirpm[a] <= 0 || speed_millirpm[a] > int32_t(ROVER_DIRECT_MAX_RPM) * 1000L)
+        return false;
+    }
+    for (uint8_t a = 0; a < 4; ++a)
+      if (TEST(update_mask, a)) rover_counted_speed_millirpm[a] = speed_millirpm[a];
+    return true;
+  }
